<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:padding="24dp"
    android:background="#ECEFF1">

    <TextView
        android:id="@+id/tvHallwayTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Main Base Hallway"
        android:textSize="26sp"
        android:textColor="#0D47A1"
        android:fontFamily="serif"
        android:textStyle="bold"
        android:layout_marginBottom="16dp" />

    <ImageView
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:src="@drawable/img_agent"
        android:contentDescription="Agent Image"
        android:layout_marginBottom="16dp" />

    <TextView
        android:id="@+id/tvHallwayInventory"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="16sp"
        android:textColor="#2E7D32"
        android:fontFamily="sans-serif-medium"
        android:layout_marginBottom="12dp" />

    <TextView
        android:id="@+id/tvHallwayStory"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="16sp"
        android:textColor="#37474F"
        android:fontFamily="sans-serif"
        android:layout_marginBottom="24dp" />

    <Button
        android:id="@+id/btnGoMessHall"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Enter Mess Hall"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:fontFamily="sans-serif-condensed"
        android:textStyle="bold"
        android:padding="12dp"
        android:background="@drawable/btn_custom"
        android:layout_marginBottom="12dp" />

    <Button
        android:id="@+id/btnGoBarracks"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Sneak to Barracks"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:fontFamily="sans-serif-condensed"
        android:textStyle="bold"
        android:padding="12dp"
        android:background="@drawable/btn_accent" />

</LinearLayout>