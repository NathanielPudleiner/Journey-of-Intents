<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:padding="24dp"
    android:background="#E0F7FA">

    <TextView
        android:id="@+id/tvLabTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Secret Research Lab"
        android:textSize="26sp"
        android:textColor="#006064"
        android:fontFamily="serif"
        android:textStyle="bold"
        android:layout_marginBottom="16dp" />

    <ImageView
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:src="@drawable/img_agent"
        android:contentDescription="Lab Agent Image"
        android:layout_marginBottom="16dp" />

    <TextView
        android:id="@+id/tvLabStory"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="16sp"
        android:textColor="#37474F"
        android:fontFamily="sans-serif"
        android:layout_marginBottom="24dp" />

    <Button
        android:id="@+id/btnStealLaser"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Steal Laser Cutter Gadget"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:fontFamily="sans-serif-condensed"
        android:textStyle="bold"
        android:padding="12dp"
        android:background="@drawable/btn_custom"
        android:layout_marginBottom="12dp" />

    <Button
        android:id="@+id/btnPressRedButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Press Random Red Button"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:fontFamily="sans-serif-condensed"
        android:textStyle="bold"
        android:padding="12dp"
        android:background="@drawable/btn_danger" />

</LinearLayout>