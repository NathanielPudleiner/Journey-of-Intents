<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:padding="24dp"
    android:background="#ECEFF1">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="A Journey of Intents"
        android:textSize="28sp"
        android:textColor="#0D47A1"
        android:fontFamily="serif"
        android:textStyle="bold"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="16dp" />

    <ImageView
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:src="@drawable/img_agent"
        android:contentDescription="Agent Icon"
        android:layout_marginBottom="16dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Secret Agent Escape Mission"
        android:textSize="18sp"
        android:textColor="#37474F"
        android:fontFamily="sans-serif-medium"
        android:textStyle="italic"
        android:layout_marginBottom="24dp" />

    <EditText
        android:id="@+id/etAgentName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Enter Agent Name"
        android:textSize="16sp"
        android:padding="12dp"
        android:background="#FFFFFF"
        android:textColor="#000000"
        android:layout_marginBottom="24dp" />

    <Button
        android:id="@+id/btnStart"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Begin Escape Mission"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:fontFamily="sans-serif-condensed"
        android:textStyle="bold"
        android:padding="14dp"
        android:background="@drawable/btn_custom" />

</LinearLayout>