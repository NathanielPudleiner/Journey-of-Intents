<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:padding="24dp"
    android:background="#F3E5F5">

    <TextView
        android:id="@+id/tvRoofTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Rooftop Helipad"
        android:textSize="26sp"
        android:textColor="#6A1B9A"
        android:fontFamily="serif"
        android:textStyle="bold"
        android:layout_marginBottom="16dp" />

    <ImageView
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:src="@drawable/img_escape"
        android:contentDescription="Roof Chopper Image"
        android:layout_marginBottom="16dp" />

    <TextView
        android:id="@+id/tvRoofStory"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="16sp"
        android:textColor="#4A148C"
        android:fontFamily="sans-serif"
        android:layout_marginBottom="24dp" />

    <Button
        android:id="@+id/btnBoardChopper"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Board Escape Helicopter"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:fontFamily="sans-serif-condensed"
        android:textStyle="bold"
        android:padding="12dp"
        android:background="@drawable/btn_accent"
        android:layout_marginBottom="12dp" />

    <Button
        android:id="@+id/btnZiplineWater"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Zipline to Water"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:fontFamily="sans-serif-condensed"
        android:textStyle="bold"
        android:padding="12dp"
        android:background="@drawable/btn_custom" />

</LinearLayout>